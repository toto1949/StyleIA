PORT=8080
NODE_ENV=development
PUBLIC_BASE_URL=https://cosponsor-crisping-matcher.ngrok-free.dev
STYLEAI_JWT_SECRET=replace-with-at-least-32-random-bytes
STYLEAI_JWT_ISSUER=https://api.sceneme.app
STYLEAI_JWT_AUDIENCE=com.sceneme.app
STYLEAI_ACCESS_TOKEN_TTL_SECONDS=900
STYLEAI_REFRESH_TOKEN_TTL_DAYS=30
STYLEAI_DATA_PATH=./data/styleai.json
STYLEAI_UPLOAD_DIR=./uploads
STYLEAI_MAX_UPLOAD_BYTES=12000000
STYLEAI_MAX_UPLOAD_PIXELS=40000000
STYLEAI_MAX_CONCURRENT_IMAGE_JOBS_PER_USER=1
STYLEAI_MAX_CONCURRENT_VIDEO_JOBS_PER_USER=1
STYLEAI_PROVIDER_TIMEOUT_MS=360000
# PostgreSQL-backed in production, so limits hold across rolling deploys and
# multiple instances. Raw IP addresses are HMACed before storage.
STYLEAI_API_RATE_LIMIT_PER_MINUTE=300
STYLEAI_USER_RATE_LIMIT_PER_MINUTE=180
STYLEAI_AUTH_RATE_LIMIT_PER_15_MINUTES=30
STYLEAI_APP_STORE_NOTIFICATION_RATE_LIMIT_PER_MINUTE=300
# Required in production. Owner-approved operational spend ceilings; jobs are
# rejected before provider submission when their reserved estimate exceeds one.
STYLEAI_DAILY_USER_BUDGET_USD=
STYLEAI_DAILY_GLOBAL_BUDGET_USD=
STYLEAI_ESTIMATED_IMAGE_COST_USD=0.04
STYLEAI_ESTIMATED_PREMIUM_IMAGE_COST_USD=0.08
STYLEAI_ESTIMATED_VIDEO_COST_USD=0.35
STYLEAI_ESTIMATED_TALKING_VIDEO_COST_USD=1.35
# Production requires PostgreSQL. Local JSON remains available only when this is blank.
DATABASE_URL=
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Production requires a private S3-compatible bucket. Leave blank for local filesystem mode.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_UPLOAD_TTL_SECONDS=900
OBJECT_STORAGE_DOWNLOAD_TTL_SECONDS=600
APPLE_CLIENT_ID=com.sceneme.app
# Sign in with Apple key used to exchange authorization codes and revoke the
# user's refresh token during in-app account deletion.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"
# Separate random secret (32+ characters) for encrypting stored Apple refresh tokens.
STYLEAI_DATA_ENCRYPTION_KEY=
# App Store Connect In-App Purchase key for server-side subscription checks.
APP_STORE_ISSUER_ID=bcc9e67d-a7f4-444f-a1a2-9deefff625fd
APP_STORE_KEY_ID=399AQ2HR33
APP_STORE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"
APP_STORE_BUNDLE_ID=com.sceneme.app
# Numeric Apple ID assigned after the app record exists in App Store Connect.
APP_STORE_APPLE_ID=6822467260
# Comma-separated DER certificate paths downloaded from Apple's PKI page.
# Keep these files current and verify their published SHA-256 fingerprints.
APP_STORE_ROOT_CA_PATHS=./config/apple/AppleRootCA-G2.cer,./config/apple/AppleRootCA-G3.cer
APP_STORE_ENABLE_ONLINE_CHECKS=true
GOOGLE_CLIENT_ID=
FAL_KEY=

# OpenAI improves user-written custom scene templates. Keep this server-side.
OPENAI_API_KEY=
OPENAI_TEMPLATE_MODEL=gpt-5-mini
OPENAI_MODERATION_MODEL=omni-moderation-latest

# --- Image models (Kontext pro is ~$0.04/image; max/multi is ~$0.08) ---
FAL_MODEL=fal-ai/flux-pro/kontext
FAL_PREMIUM_MODEL=fal-ai/flux-pro/kontext/max
# Companion friend/pet path. Default pro multi (~$0.04). Use max/multi only if needed.
FAL_MULTI_MODEL=fal-ai/flux-pro/kontext/multi
FAL_PREMIUM_MULTI_MODEL=fal-ai/flux-pro/kontext/max/multi
# Used only by the eco fal-ai/flux-kontext/dev path; Pro does not accept this field.
FAL_KONTEXT_NUM_INFERENCE_STEPS=36
FAL_KONTEXT_GUIDANCE_SCALE=3.75
# Slightly higher guidance for friend/pet multi-image generations.
FAL_MULTI_GUIDANCE_SCALE=4.5
# Output frame for generated scenes (9:16 = full-body vertical editorial).
STYLEAI_IMAGE_ASPECT_RATIO=9:16

# --- Cost controls ---
# Eco: cheaper kontext/dev + 360p video (noticeable quality drop — leave false in prod).
STYLEAI_ECO_MODE=false
FAL_ECO_MODEL=fal-ai/flux-kontext/dev
# Zero fal spend when the same user regenerates identical photo+prompt.
STYLEAI_REUSE_IDENTICAL_RESULTS=true

# --- Video (PixVerse: ~$0.035/s @540p, ~$0.045/s @720p) ---
FAL_VIDEO_MODEL=fal-ai/pixverse/v6/image-to-video
STYLEAI_VIDEO_RESOLUTION=720p
STYLEAI_VIDEO_DURATION_SECONDS=5
# Keep crafted face-lock prompts (enabled lets PixVerse rewrite the prompt).
STYLEAI_VIDEO_THINKING_TYPE=disabled

# Talking clips: ElevenLabs TTS + lipsync/mux on fal (uses FAL_KEY).
FAL_TTS_MODEL=fal-ai/elevenlabs/tts/turbo-v2.5
FAL_LIPSYNC_MODEL=fal-ai/sync-lipsync/v3
FAL_MERGE_AUDIO_VIDEO_MODEL=fal-ai/ffmpeg-api/merge-audio-video
STYLEAI_TTS_VOICE_FEMALE=Rachel
STYLEAI_TTS_VOICE_MALE=Adam
STYLEAI_TTS_VOICE_DEFAULT=Aria
STYLEAI_ENABLE_MOCK_GENERATION=false
STYLEAI_FAL_FALLBACK_TO_MOCK_ON_BILLING=false
