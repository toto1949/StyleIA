PORT=8080
NODE_ENV=development
PUBLIC_BASE_URL=https://cosponsor-crisping-matcher.ngrok-free.dev
STYLEAI_JWT_SECRET=replace-with-at-least-32-random-bytes
STYLEAI_DATA_PATH=./data/styleai.json
STYLEAI_UPLOAD_DIR=./uploads
STYLEAI_MAX_UPLOAD_BYTES=12000000
APPLE_CLIENT_ID=com.sceneme.app
GOOGLE_CLIENT_ID=
FAL_KEY=

# OpenAI improves user-written custom scene templates. Keep this server-side.
OPENAI_API_KEY=
OPENAI_TEMPLATE_MODEL=gpt-5-mini

# --- Image models (Kontext pro is ~$0.04/image; max/multi is ~$0.08) ---
FAL_MODEL=fal-ai/flux-pro/kontext
# Companion friend/pet path. Default pro multi (~$0.04). Use max/multi only if needed.
FAL_MULTI_MODEL=fal-ai/flux-pro/kontext/multi
# Solo steps are free COGS on pro (priced per image). Higher = sharper/more stable.
FAL_KONTEXT_NUM_INFERENCE_STEPS=36
FAL_KONTEXT_GUIDANCE_SCALE=3.75
# Slightly higher guidance for friend/pet multi-image generations.
FAL_MULTI_GUIDANCE_SCALE=4.5
# Output frame for generated scenes (9:16 = full-body vertical editorial).
STYLEAI_IMAGE_ASPECT_RATIO=9:16

# --- Cost controls ---
# Eco: cheaper kontext/dev + 360p video (noticeable quality drop — leave false in prod).
STYLEAI_ECO_MODE=false
FAL_ECO_MODEL=fal-ai/flux-kontext/dev
# Zero fal spend when the same user regenerates identical photo+prompt.
STYLEAI_REUSE_IDENTICAL_RESULTS=true

# --- Video (PixVerse: ~$0.035/s @540p, ~$0.045/s @720p) ---
FAL_VIDEO_MODEL=fal-ai/pixverse/v6/image-to-video
STYLEAI_VIDEO_RESOLUTION=720p
STYLEAI_VIDEO_DURATION_SECONDS=5
# Keep crafted face-lock prompts (enabled lets PixVerse rewrite the prompt).
STYLEAI_VIDEO_THINKING_TYPE=disabled

# Talking clips: ElevenLabs TTS + lipsync/mux on fal (uses FAL_KEY).
FAL_TTS_MODEL=fal-ai/elevenlabs/tts/turbo-v2.5
FAL_LIPSYNC_MODEL=fal-ai/sync-lipsync/v3
FAL_MERGE_AUDIO_VIDEO_MODEL=fal-ai/ffmpeg-api/merge-audio-video
STYLEAI_TTS_VOICE_FEMALE=Rachel
STYLEAI_TTS_VOICE_MALE=Adam
STYLEAI_TTS_VOICE_DEFAULT=Aria
STYLEAI_ENABLE_MOCK_GENERATION=false
STYLEAI_FAL_FALLBACK_TO_MOCK_ON_BILLING=false
