PORT=8080
NODE_ENV=development
PUBLIC_BASE_URL=https://cosponsor-crisping-matcher.ngrok-free.dev
STYLEAI_JWT_SECRET=replace-with-at-least-32-random-bytes
STYLEAI_DATA_PATH=./data/styleai.json
STYLEAI_UPLOAD_DIR=./uploads
STYLEAI_MAX_UPLOAD_BYTES=12000000
APPLE_CLIENT_ID=toto.StyleAI
FAL_KEY=
FAL_MODEL=fal-ai/flux-pro/kontext
FAL_KONTEXT_NUM_INFERENCE_STEPS=28
FAL_KONTEXT_GUIDANCE_SCALE=3.5
STYLEAI_ENABLE_MOCK_GENERATION=false
STYLEAI_FAL_FALLBACK_TO_MOCK_ON_BILLING=false
