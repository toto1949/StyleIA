{
  "name": "styleai-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "STYLEAI_ENABLE_MOCK_GENERATION=true node src/server.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:import-json": "node scripts/import-json.mjs",
    "storage:migrate-legacy": "node scripts/migrate-legacy-media.mjs",
    "test:companions": "node scripts/verify-companion-prompts.mjs",
    "test:subscriptions": "node scripts/verify-subscription-gates.mjs",
    "test:credit-storage": "node scripts/verify-credit-ledger-storage.mjs",
    "test:rate-limits": "node scripts/verify-rate-limits.mjs",
    "test:provider-state": "node scripts/verify-provider-state-storage.mjs",
    "test:content-safety": "node scripts/verify-content-safety.mjs",
    "test:upload-validation": "node scripts/verify-upload-validation.mjs",
    "test:fal-queue": "node scripts/verify-fal-queue.mjs",
    "test:smoke": "bash scripts/ci-smoke.sh",
    "test": "npm run test:companions && npm run test:subscriptions && npm run test:credit-storage && npm run test:rate-limits && npm run test:provider-state && npm run test:content-safety && npm run test:upload-validation && npm run test:fal-queue && npm run test:smoke && npm run test:reviewer",
    "test:reviewer": "node scripts/verify-reviewer-account.mjs"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.883.0",
    "@fal-ai/client": "^1.10.1",
    "pg": "^8.16.3",
    "sharp": "^0.35.5"
  }
}
